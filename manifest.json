{
  "manifest_version": 3,
  "name": "Video Pop-Out to Second Screen",
  "version": "1.3",
  "description": "When you switch away from a playing video (YouTube, and the sites you choose), move it to its own window, for KWin to put fullscreen on your other screen.",
  "permissions": [
    "tabs",
    "system.display",
    "storage",
    "scripting",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "*://www.youtube.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Pop out this video, or bring it back",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "toggle-popout": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Pop out this video, or bring it back"
    }
  }
}
